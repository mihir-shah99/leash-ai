# AgentShield environment configuration (copy to .env and adjust).

# --- Control plane API (apps/api) ---
# Async SQLAlchemy URL for Postgres.
DATABASE_URL=postgresql+asyncpg://agentshield:agentshield_password@localhost:5432/agentshield
# Comma-separated CORS allow-list (no wildcard when credentials are used).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Log every SQL statement (includes payloads) — keep off outside local debugging.
SQL_ECHO=false

# --- Web dashboard (apps/web, Vite) ---
# Base URL the dashboard calls.
VITE_API_BASE_URL=http://localhost:8000
# API key the dashboard uses to authenticate (mint with scripts/create_tenant.py).
VITE_API_KEY=

# --- SDK (packages/sdk-python, packages/sdk-typescript) ---
# Default control-plane URL and tenant API key for the SDKs.
AGENT_SHIELD_BASE_URL=http://localhost:8000
AGENT_SHIELD_API_KEY=
